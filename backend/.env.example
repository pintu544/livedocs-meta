# Copy to .env (never commit .env). Keys stay server-side only.
# Live provider (M-1, 2026-10-27): Meta Model API, Muse Spark 1.3.
# For a Meta base, the key MUST be MODEL_API_KEY — llmClientFromEnv
# refuses a Meta base without it (QA B1: LLM_API_KEY is never sent to
# Meta, so a stale FastRouter key cannot cause a confusing 401).
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Slice 2 interim provider (retired from the submission path):
# FastRouter, OpenAI-compatible. Kept here only so a local run can
# still compare against it; grounding refuses non-Meta bases.
# LLM_BASE_URL=https://api.fastrouter.ai/api/v1
# LLM_MODEL=openai/gpt-5.2
# LLM_API_KEY=
PORT=4000
