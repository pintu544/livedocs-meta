# Copy to .env (never commit .env). Keys stay server-side only.
# Interim provider (Slice 2): FastRouter, OpenAI-compatible.
LLM_BASE_URL=https://api.fastrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.2
LLM_API_KEY=
# Migration target (M-1): Meta Model API. Do NOT set both at once —
# llmClientFromEnv picks Meta when LLM_BASE_URL contains "meta.ai".
# MODEL_API_KEY=
# MODEL_ID=muse-spark-1.3
PORT=4000
