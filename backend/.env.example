# Copy to .env (never commit .env). Keys stay server-side only.
# Interim provider (Slice 2): FastRouter, OpenAI-compatible.
LLM_BASE_URL=https://api.fastrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.2
LLM_API_KEY=
# Migration target (M-1): Meta Model API. For a Meta base, the key
# MUST be MODEL_API_KEY — llmClientFromEnv refuses a Meta base without
# it (QA B1: LLM_API_KEY is never sent to Meta, so a stale FastRouter
# key cannot cause a confusing 401).
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3
# MODEL_API_KEY=
PORT=4000
